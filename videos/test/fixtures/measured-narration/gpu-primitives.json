      "beats": [
        {
          "say": "Real-number addition is associative, but floating-point addition rounds each intermediate value. Compare a large positive value, its large negative partner, and a small residual of three point one four.\n",
          "start": 0.4,
          "end": 12.616,
          "duration": 12.216,
          "until": 13.166
        },
        {
          "say": "Pair the large values first and they cancel, leaving three point one four. Add the small residual to the large negative value first and it rounds away at this scale. The next addition then yields zero.\n",
          "start": 13.166,
          "end": 25.622,
          "duration": 12.456,
          "until": 26.322
        },
        {
          "say": "Changing addition order can produce different low-order bits even when both trees are race-free. Validate against suitable tolerances and check error growth when changing tile size or reduction layout.\n",
          "start": 26.322,
          "end": 38.562,
          "duration": 12.24,
          "until": 39.112
        }
      ],
