      },
      "beats": [
        {
          "say": "Contain the affected replica by stopping new admission. Readiness changes future routing; it does not instantly cancel in-flight requests or close every existing connection. Our two-replica trace keeps those existing requests visible while later arrivals move to the healthy worker. Safe retries also need the request side-effect and deduplication contract.",
          "start": 0.4,
          "end": 22.791999999999998,
          "duration": 22.392,
          "until": 23.441999999999997
        },
        {
          "say": "A process-corrupting CUDA error requires stronger containment than an ordinary allocation failure. An illegal-address error can surface at a later synchronization point and leaves the process unsafe for continued work. Preserve the first observed exact error, terminate and relaunch that process, and expand scope only when device or node evidence requires it.",
          "start": 23.441999999999997,
          "end": 45.089999999999996,
          "duration": 21.648,
          "until": 45.739999999999995
        }
      ],
