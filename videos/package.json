{
  "name": "leetllm-video-lessons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "render:full": "node soundtracks/render.mjs",
    "test": "node --test test/*.test.mjs",
    "validate": "node render.mjs --all --validate",
    "preview": "node render.mjs --all --preview",
    "audio": "node render.mjs --all --audio-only",
    "captions": "node regenerate-captions.mjs --all",
    "render": "node render.mjs --all && node regenerate-captions.mjs --all",
    "stage:check": "node tools/stage-check.mjs",
    "stage:stills": "node tools/stage-stills.mjs",
    "format:tests": "node tools/format-authored.mjs --tests-only --write",
    "format:tests:check": "node tools/format-authored.mjs --tests-only --check",
    "format:authored": "node tools/format-authored.mjs --write",
    "format:authored:check": "node tools/format-authored.mjs --check"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@xmldom/xmldom": "0.9.12",
    "es-module-lexer": "3.0.4",
    "vizmatic": "0.8.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@babel/generator": "8.1.2",
    "@babel/parser": "8.1.2",
    "@babel/traverse": "8.1.2",
    "prettier": "3.10.1"
  }
}
