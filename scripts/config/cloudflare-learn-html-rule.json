{
  "ref": "leetllm_learn_preserve_email_literals",
  "description": "Preserve literal lesson examples and React hydration on Learn routes",
  "expression": "http.host eq \"leetllm.com\" and starts_with(http.request.uri.path, \"/learn/\")",
  "enabled": true,
  "action": "set_config",
  "action_parameters": {
    "email_obfuscation": false
  }
}
