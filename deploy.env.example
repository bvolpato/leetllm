# Copy to secrets/deploy.env (gitignored) for local Cloud Run, sandbox,
# Cloudflare, Supabase, and iOS release tooling.
# Never commit secrets/deploy.env or any files inside secrets/.

# Google Cloud Platform
GCLOUD_ACCOUNT=you@example.com
GCLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
SERVICE_NAME=leetllm
PRACTICE_SANDBOX_SERVICE=leetllm-sandbox

# Optional: override least-privilege service account emails
# RUNTIME_SERVICE_ACCOUNT=leetllm-runtime@your-gcp-project-id.iam.gserviceaccount.com
# SANDBOX_SERVICE_ACCOUNT=leetllm-sandbox@your-gcp-project-id.iam.gserviceaccount.com

# Cloudflare (optional cache purge after deploy; token belongs in web/.env.local)
CF_ZONE_ID=your-cloudflare-zone-id

# Supabase Management API (for update-supabase.sh)
SUPABASE_PROJECT_REF=your-supabase-project-ref

# Monitoring / Analytics service account (for AGENTS_MONITOR.md queries)
STATS_SERVICE_ACCOUNT=stats-reader@your-gcp-project-id.iam.gserviceaccount.com

# Optional: owner email allowed to access unlisted iOS private blogs
# IOS_PRIVATE_BLOG_EMAIL=you@example.com

# Optional: Apple Developer Team ID for iOS signing
# IOS_TEAM_ID=YOURTEAMID
