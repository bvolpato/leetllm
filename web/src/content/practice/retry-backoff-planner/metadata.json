  "solutionGuide": [
    "Retry policy should make one small deterministic decision: retryable error, attempt budget, then capped exponential delay.",
    "",
    "```python",
    "import math",
    "",
    "class RetryPolicy:",
    "    def __init__(self, max_attempts: int, base_delay: float, max_delay: float, retryable_errors: set[str]):",
    "        self.max_attempts = max_attempts",
    "        self.base_delay = base_delay",
    "        self.max_delay = max_delay",
    "        self.retryable_errors = set(retryable_errors)",
    "",
    "    def next_delay(self, attempt: int, error_code: str):",
    "        if error_code not in self.retryable_errors:",
    "            return None",
    "        if attempt >= self.max_attempts:",
    "            return None",
    "        # Exponent clamped so attempt < 1 still uses base_delay (2 ** 0).",
    "        exponent = max(0, attempt - 1)",
    "        if self.base_delay == 0 or self.max_delay == 0:",
    "            return 0.0",
    "        if self.base_delay >= self.max_delay:",
    "            return self.max_delay",
    "        try:",
    "            delay = math.ldexp(self.base_delay, exponent)",
    "        except OverflowError:",
    "            return self.max_delay",
    "        return min(self.max_delay, delay)",
    "```"
  ]
