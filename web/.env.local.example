# Copy to web/.env.local (gitignored) for local development.
# Leave optional variables unset to run the curriculum, quizzes, and
# coding practice locally with zero external cloud accounts.

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase (authentication, progress sync, comments, study state)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Server-only secret (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI tutor (Leety) and lesson personalization (server-only)
GEMINI_API_KEY=
PERSONALIZATION_MODELS=google/gemini-3.5-flash-lite

# Optional: transactional email (server-only)
RESEND_API_KEY=

# Optional: isolated practice runner service (set in production Cloud Run)
# Leave unset locally to use the hardened local Python/Java runner.
# PRACTICE_RUNNER_URL=https://leetllm-sandbox-xxxx-uc.a.run.app
# PRACTICE_RUNNER_REQUIRE_REMOTE=false

# Optional: owner email for private iOS blog endpoint
# IOS_PRIVATE_BLOG_EMAIL=

# Optional: Cloudflare cache purge token (deploy tooling only)
# CLOUDFLARE_CACHE_PURGER=
