{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "predev": "pnpm glossary:build && pnpm content-routes:build && pnpm search-index:build",
    "dev": "../scripts/next-dev-local-auth",
    "predev:port": "pnpm glossary:build && pnpm content-routes:build && pnpm search-index:build",
    "dev:port": "../scripts/next-dev-local-auth -p 23456",
    "prebuild": "pnpm glossary:build && pnpm content-routes:build && pnpm search-index:build && pnpm llms:build && node -e \"if (!require('fs').existsSync('./src/lib/googlebot-cidrs.json')) { require('child_process').execSync('tsx scripts/fetch-googlebot-cidrs.ts', {stdio:'inherit'}) }\"",
    "build": "next build",
    "start": "next start",
    "prelint": "pnpm glossary:build && pnpm content-routes:build && pnpm search-index:build",
    "lint": "eslint",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "test:dependency-audit": "node --test scripts/audit-dependencies.fixtures.mjs",
    "pretest": "pnpm glossary:build && pnpm content-routes:build && pnpm search-index:build",
    "test": "vitest",
    "pretypecheck": "pnpm glossary:build && pnpm content-routes:build && pnpm search-index:build",
    "typecheck": "tsc --noEmit",
    "fetch:googlebot-cidrs": "tsx scripts/fetch-googlebot-cidrs.ts",
    "glossary:build": "tsx scripts/generate-glossary.ts",
    "content-routes:build": "tsx scripts/generate-content-route-index.ts",
    "search-index:build": "tsx scripts/generate-learn-search-index.ts",
    "runtime-content:validate": "tsx scripts/validate-runtime-content.ts",
    "runtime-image:validate": "tsx scripts/validate-runtime-image.ts",
    "llms:build": "tsx scripts/generate-llms-txt.ts",
    "practice:new": "tsx scripts/create-practice-problem.ts",
    "practice:validate": "tsx scripts/validate-practice-solutions.ts",
    "ios:export": "pnpm glossary:build && pnpm illustrations:build && pnpm diagrams:build && tsx scripts/export-ios-content.ts",
    "ios:export:ci": "pnpm glossary:build && pnpm diagrams:build && tsx scripts/hydrate-ios-images.ts && tsx scripts/export-ios-content.ts",
    "ios:hydrate-images": "tsx scripts/hydrate-ios-images.ts",
    "ios:validate": "node ../scripts/validate-ios-export.mjs",
    "illustrations:build": "tsx tools/illustrations/build.ts",
    "illustrations:build:article": "tsx tools/illustrations/build.ts --article",
    "illustrations:typecheck": "tsx tools/illustrations/typecheck.ts",
    "diagrams:build": "tsx tools/diagrams/build.ts",
    "diagrams:build:article": "tsx tools/diagrams/build.ts --article",
    "illustrations:format": "tsx tools/illustrations/format.ts --write",
    "illustrations:format:check": "tsx tools/illustrations/format.ts --check",
    "illustrations:new": "tsx tools/illustrations/new.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "entities": "9.0.0",
    "jsonrepair": "3.15.0",
    "katex": "0.19.1",
    "lucide-react": "^1.66.0",
    "mermaid": "12.2.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "vizmatic": "0.10.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "gifenc": "^1.0.3",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "satori": "^0.63.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687"
      ]
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    },
    "overrides": {
      "@xmldom/xmldom": "0.9.12",
      "@babel/core@<=7.29.0": "7.29.7",
      "@hono/node-server": "2.0.11",
      "@humanfs/node@<0.16.8": "0.16.8",
      "@modelcontextprotocol/sdk@<1.32.0": "1.32.0",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0 <8.18.0": "8.18.0",
      "basic-ftp": "5.3.1",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.21",
      "body-parser@<2.3.0": "2.3.0",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "browserslist@<=4.28.6": "4.28.7",
      "dompurify@>=3.4.13 <3.4.17": "3.4.17",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "express-rate-limit@>=8.2.0 <8.2.2": "8.2.2",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "fflate@>=0.7.0 <0.7.5": "0.7.5",
      "flatted@<=3.4.1": "3.4.2",
      "hono@<4.13.11": "4.13.11",
      "ip-address@<10.7.1": "10.7.1",
      "js-yaml@<4.3.2": "4.3.2",
      "katex@<0.18.2": "0.18.2",
      "minimatch@<3.1.3": "3.1.5",
      "minimatch@3.1.5>brace-expansion": "5.0.12",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "proxy-addr@>=1.1.0 <2.0.8": "2.0.8",
      "qs@<6.16.0": "6.16.0",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "undici@>=8.0.0 <8.12.2": "8.12.2",
      "vite@>=7.0.0 <7.3.7": "7.3.7",
      "ws@<8.21.0": "8.21.0"
    }
  }
}
